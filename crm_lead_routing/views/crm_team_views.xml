<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_team_view_form_routing" model="ir.ui.view">
        <field name="name">crm.team.form.routing</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_routing_rules" type="object" class="oe_stat_button" icon="fa-random"
                        groups="sales_team.group_sale_manager">
                    <field name="routing_rule_count" widget="statinfo" string="Routing Rules"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_routing_log_view_list" model="ir.ui.view">
        <field name="name">crm.routing.log.list</field>
        <field name="model">crm.routing.log</field>
        <field name="arch" type="xml">
            <list string="Routing Log" create="false" edit="false">
                <field name="date"/>
                <field name="lead_id"/>
                <field name="channel" optional="show"/>
                <field name="campaign_id" optional="show"/>
                <field name="rule_id"/>
                <field name="team_id"/>
                <field name="previous_user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="trigger" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="crm_routing_log_view_search" model="ir.ui.view">
        <field name="name">crm.routing.log.search</field>
        <field name="model">crm.routing.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="lead_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="rule_id"/>
                <field name="campaign_id"/>
                <filter name="no_rule" string="Without Rule" domain="[('rule_id', '=', False)]"/>
                <filter name="no_user" string="Without Salesperson" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_rule" string="Rule" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="crm_routing_log_view_pivot" model="ir.ui.view">
        <field name="name">crm.routing.log.pivot</field>
        <field name="model">crm.routing.log</field>
        <field name="arch" type="xml">
            <pivot string="Assignments" sample="1">
                <field name="user_id" type="row"/>
                <field name="date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="crm_routing_log_view_graph" model="ir.ui.view">
        <field name="name">crm.routing.log.graph</field>
        <field name="model">crm.routing.log</field>
        <field name="arch" type="xml">
            <graph string="Assignments" sample="1">
                <field name="user_id"/>
            </graph>
        </field>
    </record>

    <record id="action_crm_routing_log" model="ir.actions.act_window">
        <field name="name">Routing Log</field>
        <field name="res_model">crm.routing.log</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>
</odoo>
